<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="using:Deer_o_matic.ViewModels"
                    xmlns:models="clr-namespace:Deer_o_matic.Models">

    <DataTemplate DataType="vm:AreaDataViewModel"  x:Key="AreaDataTemplate">
        <Grid ColumnDefinitions="*, Auto" Margin="8">
            <TextBlock Grid.Column="0" Text="{Binding Name}"/>

            <!-- $parent[UserControl] walks up the visual tree until it finds a UserControl (Which will be the MapView) -->
            <Button Grid.Column="1" 
                    Command="{Binding $parent[UserControl].((vm:MapViewModel)DataContext).DeleteAreaData}"
                    CommandParameter="{Binding .}">
                    Delete
            </Button>
        </Grid>    
    </DataTemplate>

</ResourceDictionary>
