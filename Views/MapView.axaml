<UserControl xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:vm="using:Deer_o_matic.ViewModels"
            xmlns:mapsui="clr-namespace:Mapsui.UI.Avalonia;assembly=Mapsui.UI.Avalonia"
            x:Class="Deer_o_matic.Views.MapView"
            x:DataType="vm:MapViewModel"
>


    <Grid ColumnDefinitions="180, *">
        <Grid Grid.Column="0" RowDefinitions="Auto, Auto, *, Auto, Auto" Margin="8, 8, 8, 8">
            
            <TextBlock Grid.Row="0" Margin="0, 0, 0, 8">KML Area Files:</TextBlock>
            <Rectangle Grid.Row="1" Height="1" Fill="Gray" HorizontalAlignment="Stretch"/>
            
            <ScrollViewer Grid.Row="2" Margin="0, 8, 0, 8">

            </ScrollViewer>

            <Rectangle Grid.Row="3" Height="1" Fill="Gray" HorizontalAlignment="Stretch"/>
            <Button Grid.Row="4" Margin="0, 8, 0, 0">Add New</Button>
        
                
        </Grid>
        <mapsui:MapControl Grid.Column="1" Map="{Binding SimpleMap}" />
    
    </Grid>
</UserControl>